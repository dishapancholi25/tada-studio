# Agentic Studio Environment Configuration
# Copy this file to .env and fill in the values

# ==========================================
# LLM Provider Configuration
# ==========================================
# At least one LLM provider must be configured

# Azure OpenAI Configuration
# Required if using Azure OpenAI as your LLM provider
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# OpenAI Configuration
# Required if using OpenAI directly (not Azure)
#OPENAI_API_KEY=your_openai_api_key
#OPENAI_API_VERSION=2023-05-15
#OPENAI_DEPLOYMENT_NAME=your_deployment_name
#OPENAI_ENDPOINT=https://api.openai.com/
#OPENAI_BASE=https://api.openai.com/
#KEY_OPENAI_API_EMBEDDING_MODEL=text-embedding-3-large

# Anthropic Configuration (Optional)
# Required if using Claude models
#ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# Database Configuration
# ==========================================

# Option 1: Use a single DATABASE_URL (recommended for Kubernetes/Docker deployments)
# Format: postgresql+psycopg2://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/langgraph?sslmode=prefer

# Option 2: Use individual components (will be ignored if DATABASE_URL is set)
KEY_POSTGRES_HOST=localhost
KEY_POSTGRES_DBNAME=langgraph
KEY_POSTGRES_USER=postgres
KEY_POSTGRES_PASSWORD=postgres
KEY_POSTGRES_PORT=5432
KEY_POSTGRES_SSLMODE=prefer

# ==========================================
# External Services (Optional)
# ==========================================

# Tavily API for Web Search
# Required for web search functionality in agents
TAVILY_API_KEY=your_tavily_api_key

# HuggingFace API Token (Optional but recommended)
# Authenticates HuggingFace model downloads during Docker build, raising rate
# limits and improving reliability. Not required for gated models (all LLM Guard
# models are public).
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token

# LangSmith/LangChain Tracing (Optional)
# Enables detailed execution tracing and debugging
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=agentic-studio

# Phoenix Observability (Optional)
# Enables Arize Phoenix for LLM trace exploration and evaluation
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://phoenix:6006/phoenix/v1/traces
PHOENIX_PROJECT_NAME=agentic-studio
PHOENIX_API_KEY=
PHOENIX_HOST_ROOT_PATH=/phoenix
PHOENIX_UI_URL=http://localhost:8080
PHOENIX_WORKING_DIR=/data
PHOENIX_PORT=6006
PHOENIX_POSTGRES_HOST=postgres
PHOENIX_POSTGRES_USER=postgres
PHOENIX_POSTGRES_PASSWORD=postgres
PHOENIX_POSTGRES_DB=phoenix

# ==========================================
# Email Service Configuration (Optional)
# ==========================================

# Email Provider Settings
# Required for email-based workflow triggers and notifications
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# MailSlurp Configuration (Alternative email provider)
MAILSLURP_API_KEY=your_mailslurp_api_key

# Outlook/Microsoft 365 Configuration (Alternative email provider)
# OUTLOOK_USER_PRINCIPAL_NAME=notifications@yourdomain.com
# OUTLOOK_SENDER_EMAIL=noreply@yourdomain.com
# For cross-tenant: register an app in the mailbox tenant, grant Mail.Send, and set these:
# OUTLOOK_TENANT_ID=your_azure_tenant_id
# OUTLOOK_CLIENT_ID=your_azure_client_id
# OUTLOOK_CLIENT_SECRET=your_azure_client_secret

# Remote Email Relay (send email via another Agentic Studio deployment)
# Set EMAIL_PROVIDER=remote to use this
# REMOTE_EMAIL_URL=https://agenticstudio.example.com
# REMOTE_EMAIL_API_KEY=your_relay_api_key

# Email Webhook Configuration
# Required for receiving email triggers
EMAIL_WEBHOOKS_ENABLED=false
EMAIL_WEBHOOK_BASE_URL=http://localhost:8000

# ==========================================
# Feature Flags
# ==========================================

# Enable PostgreSQL checkpointing for workflow persistence
# Default: true - Saves workflow state to database for resume capability
ENABLE_POSTGRES_CHECKPOINTING=true

# Enable native LangGraph ToolNode integration
# Default: true - Uses optimized tool execution
ENABLE_NATIVE_TOOL_NODES=true

# Enable detailed performance logging
# Default: false - Set to true for debugging performance issues
ENABLE_PERFORMANCE_LOGGING=false

# Enable the email capability (EMAIL_SEND nodes, email agent tools, email
# checkpoints and the /api/email routes).
# Default: false - email is a "coming soon" feature. While disabled the
# /api/email routes are not registered, EMAIL_SEND nodes fail with a
# coming-soon message, and email checkpoints fall back to manual approval.
EMAIL_FEATURE_ENABLED=false

# Enable email checkpoint functionality
# Default: true - Allows workflows to pause for email responses
# NOTE: not currently read by the backend; EMAIL_FEATURE_ENABLED gates email.
EMAIL_CHECKPOINT_ENABLED=true

# Use LangGraph execution engine
# Default: false - Set to true to use native LangGraph implementation
USE_LANGGRAPH_ENGINE=false

# Enable Wiki feature
# Default: true - Set to false to disable wiki functionality
# When disabled, /api/wiki/* returns 404 and frontend shows "Wiki Not Available"
ENABLE_WIKI=true

# ==========================================
# Content Security Policy (CSP) Configuration
# ==========================================

# CSP violation report URI (Optional)
# When set, CSP violations are reported to this endpoint for monitoring
# Recommended: Enable for 2 weeks before switching to enforce mode
# CSP_REPORT_URI=https://your-csp-collector.example.com/report

# CSP report-only mode (Optional)
# Default: false - Set to true to log violations without blocking
# Use this to monitor potential issues before enforcing CSP
# CSP_REPORT_ONLY=false

# ==========================================
# LLM Guard Service Configuration (Optional)
# ==========================================

# Operating mode for guardrail scanners
# "local" = in-process (default), "api" = remote service, "hybrid" = mix
# LLM_GUARD_MODE=local

# URL of the remote llm-guard service (only used in api/hybrid modes)
# LLM_GUARD_API_URL=http://llm-guard:8001

# Request timeout in seconds for scanner API calls
# LLM_GUARD_API_TIMEOUT=30

# Shared secret for backend↔llm-guard authentication
# When set, the llm-guard service rejects requests without a matching
# Authorization: Bearer <key> header. Leave empty to disable auth.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Docker Compose defaults to "local-dev-key" when unset, so local dev
# exercises the auth path automatically.  Override here or in .env.
LLM_GUARD_API_KEY=

# ==========================================
# Security Configuration
# ==========================================

# Encryption key for database credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=your_generated_encryption_key

# Dedicated encryption key for reversible PII redaction in agent memory.
# Kept separate from CREDENTIAL_ENCRYPTION_KEY so memory readability is isolated
# from credential-key rotation. Supports independent versioned rotation via
# MEMORY_ENCRYPTION_KEY_VERSION and MEMORY_ENCRYPTION_KEY_V{n}.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=your_generated_memory_encryption_key

# Shared secret to verify that identity headers came from the trusted oauth2-proxy.
# When NOT set: header-based auth works as before (backward-compatible, no enforcement).
# When SET: header-based auth is only trusted if the request carries this secret in
# the header specified by AUTH_PROXY_SHARED_SECRET_HEADER. Spoofed headers are rejected.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_PROXY_SHARED_SECRET=

# Header name carrying AUTH_PROXY_SHARED_SECRET from the trusted reverse proxy.
# Keep this aligned with your nginx proxy_set_header configuration.
AUTH_PROXY_SHARED_SECRET_HEADER=X-Auth-Proxy-Secret

# MCP Server Command Security (Optional - Advanced Configuration)
# These settings control which commands can be executed by stdio MCP servers
# and what characters are blocked to prevent command injection attacks.
# Only modify if you need to add custom MCP server runtimes or adjust security rules.

# Allowed commands for MCP stdio servers (comma-separated)
# Default: npx,node,python,python3,python3.11,python3.12,uvx,uv,deno,bun,tsx,ts-node
# Example: To add ruby: npx,node,python,python3,ruby
# MCP_ALLOWED_COMMANDS=npx,node,python,python3,python3.11,python3.12,uvx,uv,deno,bun,tsx,ts-node

# Dangerous characters blocked in commands (string of characters)
# Default: ;|&$`\n\r><()
# These prevent shell injection attacks like: node; rm -rf /
# WARNING: Removing characters reduces security. Only modify if absolutely necessary.
# MCP_DANGEROUS_CHARS_COMMAND=;|&$`\n\r><()

# Dangerous characters blocked in command arguments (string of characters)
# Default: ;|&$`\n\r
# Subset of command chars - focused on command injection prevention
# WARNING: Removing characters reduces security. Only modify if absolutely necessary.
# MCP_DANGEROUS_CHARS_ARGS=;|&$`\n\r

# ==========================================
# RBAC Configuration
# ==========================================

# Admin group name from OAuth token groups claim
ADMIN_GROUP=admins

# Comma-separated list of admin user emails (alternative to group membership)
ADMIN_USERS=admin1@example.com,admin2@example.com

# Default role assigned to new users on first login
# Options: PENDING (requires admin approval), USER (standard access), ADMIN (full access)
# Default: USER (backward compatible)
# Note: Users configured via ADMIN_USERS or ADMIN_GROUP will be assigned ADMIN role regardless
DEFAULT_USER_ROLE=USER

# Feature access cache TTL in seconds (default: 300 = 5 minutes)
# Controls how long feature permissions are cached to reduce database queries.
# Lower values = faster permission updates across workers, higher database load
# Higher values = better performance, slower permission propagation
FEATURE_ACCESS_CACHE_TTL_SECONDS=300

# ==========================================
# GitHub Integration (Optional)
# ==========================================

# GitHub Personal Access Token
# Required for GitHub-related agent tools
GITHUB_PAT=your_github_personal_access_token

# ==========================================
# API Configuration
# ==========================================

# Backend API URL
# Used by frontend and external services to connect to the backend
API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ==========================================
# MCP (Model Context Protocol) Configuration (Optional)
# ==========================================

# Enable MCP sidecar services
MCP_USE_SIDECARS=false

# MCP Sidecar Configuration (if enabled)
MCP_SIDECAR_NOTION_TYPE=http
MCP_SIDECAR_NOTION_HOST=localhost
MCP_SIDECAR_NOTION_PORT=8080

# Cloud Provider for Managed Identity Authentication
# Options: 'aws', 'azure', or 'none' (for local/other environments)
# Used for OAuth (Host Identity) authentication with MCP servers
CLOUD_PROVIDER=none

# ==========================================
# For Each Execution Limits
# ==========================================
# System ceilings for FOR_EACH nodes. Workflow authors may set stricter
# per-node limits, but cannot exceed these. Values above the ceiling are
# capped at runtime; a source array larger than the effective cap fails the
# node rather than processing it partially.

# Maximum items a single For Each node may iterate (default 5000)
FOR_EACH_MAX_ITEMS=5000

# Maximum concurrent iterations of a single For Each node (default 20).
# Bounds simultaneous LLM/API calls and in-flight iteration state.
FOR_EACH_MAX_CONCURRENCY=20

# ==========================================
# Skip Authentication for Local Development
# ==========================================

# Skip
SKIP_AUTH=true
DEV_USER_EMAIL=example@synechron.com
DEV_USER_NAME="Example User"



# ==========================================
# Notes
# ==========================================
# 1. At minimum, you need to configure:
#    - At least one LLM provider (Azure OpenAI, OpenAI, or Anthropic)
#    - Database connection (either DATABASE_URL or KEY_POSTGRES_* variables)
#
# 2. For production deployments:
#    - Set ENABLE_PERFORMANCE_LOGGING=false unless debugging
#    - Use DATABASE_URL for simpler configuration
#    - Configure CREDENTIAL_ENCRYPTION_KEY for secure storage
#    - Set appropriate SSL modes for database connections
#
# 3. For Kubernetes deployments:
#    - Use DATABASE_URL to easily override via ConfigMap
#    - Health checks are automatically filtered from logs
#
# 4. Default values are optimized for production use
#    - Checkpointing and native tools are enabled by default
#    - Performance logging is disabled by default

###########################################################
# Azure Blob Storage 
###########################################################
# Required if using Azure Blob Storage for file storage
AZURE_BLOB_STORAGE_ACCOUNT_NAME=get azure blob account name
AZURE_BLOB_STORAGE_ACCOUNT_KEY=get azure blob account key
AZURE_BLOB_CONNECTION_STRING=get default connection string
AZURE_BLOB_CONTAINER_NAME=xxxxxxxxxx
AZURE_BLOB_SAS_TTL_MINUTES=60